# Frontend (Vite). Safe to expose in the browser.
VITE_SUPABASE_URL=https://yaykfgyucipnqufydyjb.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_APP_URL=http://localhost:5173

# Stripe publishable key. Checkout itself is created on the server.
# Use the test-mode key (pk_test_...) while you are setting this up.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Edge function secrets. Set these in the Supabase dashboard
# (Project Settings → Edge Functions → Secrets). Never put them in Vite env.
# STRIPE_SECRET_KEY=sk_test_your_key
# STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
# STRIPE_PRICE_ID=price_your_one_time_price
# APP_URL=http://localhost:5173
# GEMINI_API_KEY=your_gemini_key
