# Frontend (Vite). Safe to expose in the browser.
VITE_SUPABASE_URL=https://yaykfgyucipnqufydyjb.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_APP_URL=http://localhost:5173

# Social sign-in stays hidden unless the matching flag is exactly "true".
# Turn a provider on in Supabase Auth before setting the flag.
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_APPLE_AUTH=false

# Optional donation link (Ko-fi, Buy Me a Coffee, Stripe Payment Link, or any https URL).
# The button is hidden when this is unset. No checkout is built into the app.
# VITE_DONATION_URL=https://ko-fi.com/your-page

# Extra provider hosts the browser may send through the pass-through, comma-separated.
# Must match PROVIDER_PROXY_ALLOWLIST on Netlify. Never list localhost or private hosts.
# VITE_PROXY_ALLOWLIST=

# Netlify env (not a Vite variable). Same extra hosts, read only by the edge function.
# PROVIDER_PROXY_ALLOWLIST=

# The read uses the visitor's own API key. Do not put a shared model key here.
