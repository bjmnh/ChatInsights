# Frontend (Vite). Safe to expose in the browser.
VITE_SUPABASE_URL=https://yaykfgyucipnqufydyjb.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_APP_URL=http://localhost:5173

# Social sign-in stays hidden unless the matching flag is exactly "true".
# Turn a provider on in Supabase Auth before setting the flag.
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_APPLE_AUTH=false

# Edge function secret. Set this in the Supabase dashboard
# (Project Settings → Edge Functions → Secrets). Never put it in Vite env.
# GEMINI_API_KEY=your_gemini_key
